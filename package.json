{
  "name": "firebase-demo",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@craco/craco": "^6.4.3",
    "@headlessui/react": "^1.4.3",
    "@react-query-firebase/auth": "^0.3.4",
    "@react-query-firebase/firestore": "^0.4.2",
    "@react-query-firebase/functions": "^0.2.2",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^7.0.0",
    "firebase": "^9.6.5",
    "kutty": "^0.6.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-query": "^3.34.12",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.0",
    "react-use": "^17.3.2",
    "web-vitals": "^2.1.3"
  },
  "scripts": {
    "start": "concurrently \"npm:start-js\" \"npm:start-css\"",
    "start-js": "react-scripts start",
    "start-css": "postcss -w src/css/tailwind/input.css -o src/css/tailwind/output.css",
    "build": "concurrently \"npm:build-js\" \"npm:build-css\"",
    "build-js": "react-scripts build",
    "build-css": "postcss -w src/css/tailwind/input.css -o src/css/tailwind/output.css",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "autoprefixer": "^10.4.2",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.0.15"
  }
}
